@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Nav
@inject ActiveMatchSession MatchSession

<div class="app-shell">
    <NavMenu />
    <main class="main-content">
        <div class="container">
            @Body
        </div>
    </main>
    <footer class="app-footer">
        <span class="muted">BATTLEGRID SYSTEM - SECURE CHANNEL - @DateTime.UtcNow.Year</span>
    </footer>
</div>

@code {
    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!MatchSession.IsLocked)
            return;
        var mid = MatchSession.MatchId!.Value;
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        var allowed = $"/game/{mid}";
        if (string.Equals(path, allowed, StringComparison.OrdinalIgnoreCase))
            return;

        _ = InvokeAsync(() => Nav.NavigateTo(allowed, replace: true));
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}