@implements IDisposable
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject ActiveMatchSession MatchSession
@inject QueueMatchmakingService Matchmaking
@inject ResumableMatchService Resumable

<nav class="navbar">
    <a href="/" class="navbar-brand">
        <span class="brand-icon">⬡</span>
        <span class="brand-text">BATTLE<span class="brand-accent">GRID</span></span>
    </a>

    <div class="navbar-links">
        @if (MatchSession.IsLocked)
        {
            <span class="nav-link nav-locked">MATCH IN PROGRESS</span>
        }
        else
        {
            <NavLink href="/" class="nav-link" Match="NavLinkMatch.All">HOME</NavLink>
            <NavLink href="/shiptypes" class="nav-link">FLEET</NavLink>
            @if (Auth.CurrentUser?.IsAdmin == true)
            {
                <NavLink href="/users" class="nav-link">PERSONNEL</NavLink>
            }
        }

        @if (Auth.IsLoggedIn)
        {
            @if (!MatchSession.IsLocked)
            {
                <NavLink href="/dashboard" class="nav-link">DASHBOARD</NavLink>
                <NavLink href="/settings" class="nav-link">SETTINGS</NavLink>
                <NavLink href="/match-history" class="nav-link">HISTORY</NavLink>
                @if (Auth.CurrentUser?.IsAdmin == true)
                {
                    <NavLink href="/admin" class="nav-link">ADMIN</NavLink>
                }
                @if (Resumable.HasResumableMatch && Resumable.MatchId is int navMatchId)
                {
                    <NavLink href="@($"/game/{navMatchId}")" class="nav-link nav-queue-link">REJOIN MATCH</NavLink>
                }
                else
                {
                    <NavLink href="/queue" class="nav-link nav-queue-link">
                        FIND MATCH
                        @if (Matchmaking.IsInQueue && Matchmaking.QueueStartedUtc is not null)
                        {
                            <span class="nav-queue-timer">@QueueMatchmakingService.FormatWaitClock(Matchmaking.GetQueueElapsed())</span>
                        }
                    </NavLink>
                }
            }
            <span class="nav-user">
                <span class="status-dot online"></span>
                @(string.IsNullOrWhiteSpace(Auth.CurrentUser?.UserName) ? "-" : Auth.CurrentUser!.UserName)
                @if (Auth.CurrentUser?.IsAdmin == true)
                {
                    <span class="badge badge-admin">ADMIN</span>
                }
            </span>
            <button class="btn btn-sm btn-danger" @onclick="Logout">LOGOUT</button>
        }
        else if (!MatchSession.IsLocked)
        {
            <NavLink href="/login" class="nav-link">LOGIN</NavLink>
            <NavLink href="/register" class="btn btn-sm btn-primary nav-btn">REGISTER</NavLink>
        }
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
        MatchSession.OnChange += OnMatchSessionChanged;
        Matchmaking.OnStateChanged += OnMatchmakingChanged;
        Resumable.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !Auth.IsLoggedIn)
            return;

        await Resumable.RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    void OnMatchSessionChanged() => _ = InvokeAsync(StateHasChanged);

    void OnMatchmakingChanged() => _ = InvokeAsync(StateHasChanged);

    async Task Logout()
    {
        if (MatchSession.IsLocked)
        {
            // Avoid orphaning an active match from the nav bar; use in-game Leave.
            return;
        }

        await Auth.LogoutAsync();
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
        MatchSession.OnChange -= OnMatchSessionChanged;
        Matchmaking.OnStateChanged -= OnMatchmakingChanged;
        Resumable.OnChange -= StateHasChanged;
    }
}